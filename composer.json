{
    "name": "bale/bale-sidulur",
    "description": "Sidulur public pages \u2014 landing, cek tiket, dan dashboard eksekutif",
    "license": "MIT",
    "authors": [
        {
            "name": "Ricky Romdhoni",
            "email": "ricky.romdhoni@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "bale/umpak": "*"
    },
    "autoload": {
        "psr-4": {
            "Bale\\BaleSidulur\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bale\\BaleSidulur\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bale\\BaleSidulur\\BaleSidulurServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
